{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "msvc-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QTDIR}",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
            }
        },
        {
            "name": "msvc-ninja",
            "displayName": "MSVC + Ninja (Release)",
            "inherits": "msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-ninja-debug",
            "displayName": "MSVC + Ninja (Debug)",
            "inherits": "msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-vs",
            "displayName": "Visual Studio 2022 (fallback)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QTDIR}",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-ninja",
            "configurePreset": "msvc-ninja"
        },
        {
            "name": "msvc-ninja-debug",
            "configurePreset": "msvc-ninja-debug"
        },
        {
            "name": "msvc-vs",
            "configurePreset": "msvc-vs",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "msvc-ninja",
            "configurePreset": "msvc-ninja",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
