{
    "configurations": [
        {
            "name": "Win32",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": "${workspaceFolder}/build/msvc-ninja/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/pages",
                "${workspaceFolder}/src/player",
                "${workspaceFolder}/src/widgets",
                "${workspaceFolder}/src/database"
            ],
            "defines": [
                "UNICODE",
                "_UNICODE",
                "NOMINMAX",
                "WIN32_LEAN_AND_MEAN"
            ],
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}
