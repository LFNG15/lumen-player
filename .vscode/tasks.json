{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure (msvc-ninja)",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "msvc-ninja"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "CMake: build (msvc-ninja)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "msvc-ninja"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$msCompile"],
            "dependsOn": "CMake: configure (msvc-ninja)",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: configure (debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "msvc-ninja-debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "CMake: build (debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "msvc-ninja-debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$msCompile"],
            "dependsOn": "CMake: configure (debug)"
        }
    ]
}
